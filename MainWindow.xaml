<Window x:Class="Plantify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Plantify"
        mc:Ignorable="d"
        Title="Plantify" Height="720" Width="1280" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" BorderBrush="{StaticResource BrushBorderGray}" BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="Plantify" Style="{StaticResource H1}" Margin="20"/>
                <StackPanel Margin="0,20,0,0">
                    <RadioButton Content="Мой сад" Command="{Binding GoToMyGardenCommand}" Style="{StaticResource SidebarRadioButtonStyle}"/>
                    <RadioButton Content="Энциклопедия" Command="{Binding GoToEncyclopediaCommand}" IsChecked="True" Style="{StaticResource SidebarRadioButtonStyle}"/>
                    <RadioButton Content="Расписание" Command="{Binding GoToScheduleCommand}" Style="{StaticResource SidebarRadioButtonStyle}"/>
                    <RadioButton Content="Настройки" Command="{Binding GoToSettingsCommand}" Style="{StaticResource SidebarRadioButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorderGray}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="{Binding CurrentPageTitle}" Style="{StaticResource H1}" VerticalAlignment="Center" Margin="30,0,0,0"/>
                    <Ellipse Fill="{StaticResource BrushForestGreen}" Width="40" Height="40" HorizontalAlignment="Right" Margin="0,0,30,0"/>
                </Grid>
            </Border>

            <!-- Workspace -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="5"/>
        </Grid>
        
        <!-- Overlay for Modal Dialogs -->
        <Grid Grid.ColumnSpan="2" Background="#80000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding OverlayViewModel}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ContentControl Content="{Binding OverlayViewModel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
