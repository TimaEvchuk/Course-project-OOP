<Window x:Class="Plantify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Plantify"
        xmlns:views="clr-namespace:Plantify.Views"
        mc:Ignorable="d"
        Title="Plantify" Height="720" Width="1280" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushMilkWhite}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" BorderBrush="{StaticResource BrushBorderGray}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Plantify" Style="{StaticResource H1}" Margin="20"/>
                <StackPanel Margin="0,20,0,0">
                    <RadioButton Content="Мой сад" Command="{Binding GoToMyGardenCommand}" IsChecked="True" Style="{StaticResource SidebarRadioButtonStyle}"/>
                    <RadioButton Content="Энциклопедия" Command="{Binding GoToEncyclopediaCommand}" Style="{StaticResource SidebarRadioButtonStyle}"/>
                    <RadioButton Content="Дэшборд" Command="{Binding GoToDashboardCommand}" Style="{StaticResource SidebarRadioButtonStyle}"/>
                    
                    <!-- Role-specific panels -->
                    <RadioButton Content="Админ-панель" 
                                 Command="{Binding GoToAdminPanelCommand}" 
                                 Style="{StaticResource SidebarRadioButtonStyle}"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <RadioButton Content="Менеджер-панель" 
                                 Command="{Binding GoToContentManagerPanelCommand}" 
                                 Style="{StaticResource SidebarRadioButtonStyle}"
                                 Visibility="{Binding IsContentManager, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    
                    <RadioButton Content="Настройки" Command="{Binding GoToSettingsCommand}" Style="{StaticResource SidebarRadioButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Grid.Column" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                            <Setter Property="Grid.Column" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorderGray}" BorderThickness="0,0,0,1"
                    Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <TextBlock Text="{Binding CurrentPageTitle}" Style="{StaticResource H1}" VerticalAlignment="Center" Margin="30,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,30,0">
                        <Button Content="+ Добавить растение"
                                Command="{Binding ShowAddPlantOverlayCommand}"
                                Background="{StaticResource BrushForestGreen}"
                                Foreground="{StaticResource BrushPureWhite}"
                                Padding="15,8"
                                Margin="0,0,15,0"
                                BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource BrushLightForestGreen}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <ToggleButton x:Name="notificationButton"
                                      IsChecked="{Binding IsNotificationsPanelOpen, Mode=TwoWay}"
                                      ToolTip="Уведомления">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}" Padding="4">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                            <Image Source="{Binding NotificationIconPath}" Width="24" Height="24"/>
                        </ToggleButton>

                        <Ellipse Fill="{StaticResource BrushForestGreen}" Width="40" Height="40" Margin="15,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Workspace -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>

            <Popup IsOpen="{Binding IsNotificationsPanelOpen}"
                   Placement="Left"
                   PlacementTarget="{Binding ElementName=notificationButton}"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   VerticalOffset="50"
                   Margin="0,8,0,0">
                <views:NotificationView DataContext="{Binding NotificationViewModel}"/>
            </Popup>
        </Grid>

        <!-- Overlay for Modal Dialogs -->
        <Grid Grid.ColumnSpan="2" Background="#80000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding OverlayViewModel}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ContentControl Content="{Binding OverlayViewModel}" HorizontalAlignment="Center" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"/>
        </Grid>
    </Grid>
</Window>
