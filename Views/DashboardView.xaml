<UserControl x:Class="Plantify.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Plantify.Views"
             xmlns:viewmodels="clr-namespace:Plantify.ViewModels"
             xmlns:vm="clr-namespace:Plantify.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:DashboardViewModel}"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{StaticResource BrushMilkWhite}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Widgets -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Garden Health Widget -->
            <Border Grid.Column="0"
                    MinWidth="250"
                    Padding="20"
                    Background="White"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4" BlurRadius="15" Color="{StaticResource ColorForestGreen}" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Здоровье сада" Style="{StaticResource H2}" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding GardenHealthPercentage, StringFormat={}{0}%}"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   Foreground="{Binding GardenHealthBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding GardenHealthStatusText}"
                                   FontSize="16"
                                   Foreground="{Binding GardenHealthBrush}"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Task View Selector -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <RadioButton Content="На сегодня" Style="{StaticResource FilterPillRadioButtonStyle}" Margin="0,0,8,0"
                             Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static vm:TaskPeriod.Day}"
                             IsChecked="{Binding SelectedPeriod, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:TaskPeriod.Day}}"/>
                <RadioButton Content="На неделю" Style="{StaticResource FilterPillRadioButtonStyle}" Margin="0,0,8,0"
                             Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static vm:TaskPeriod.Week}"
                             IsChecked="{Binding SelectedPeriod, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:TaskPeriod.Week}}"/>
                <RadioButton Content="На месяц" Style="{StaticResource FilterPillRadioButtonStyle}" IsEnabled="True"
                             Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static vm:TaskPeriod.Month}"
                             IsChecked="{Binding SelectedPeriod, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:TaskPeriod.Month}}"/>
            </StackPanel>

        </Grid>
        
        <TextBlock Grid.Row="1" Text="{Binding SummaryTitle}" Style="{StaticResource H2}" Margin="0,30,0,10"/>

        <!-- Task List Area -->
        <Grid Grid.Row="2">
            <!-- Day View -->
            <Grid Visibility="{Binding IsDayViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- No Tasks Message -->
                <TextBlock Text="У вас сейчас нету задач" 
                           FontSize="20" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Foreground="{StaticResource BrushGray}"
                           Visibility="{Binding ShowNoTasksMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Task List Placeholder -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollBarStyle}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowNoTasksMessage}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding TodaysTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushBorderGray}" BorderThickness="0,0,0,1" Padding="0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontWeight="Bold" FontSize="16" Margin="0,0,15,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="[?]"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TaskType}" Value="Полив">
                                                            <Setter Property="Text" Value="[П]"/>
                                                            <Setter Property="Foreground" Value="{StaticResource BrushForestGreen}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TaskType}" Value="Удобрение">
                                                            <Setter Property="Text" Value="[У]"/>
                                                            <Setter Property="Foreground" Value="{StaticResource BrushTerracotta}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding TaskDescription}" FontSize="16" VerticalAlignment="Center" FontWeight="Medium" Foreground="{StaticResource BrushDarkGreen}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Week View -->
            <ScrollViewer x:Name="WeekScrollViewer" 
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Style="{StaticResource ScrollBarStyle}"
                          Visibility="{Binding IsWeekViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Padding="0,0,0,10">
                <ItemsControl x:Name="WeekItemsControl" ItemsSource="{Binding WeekTasks}" Background="Transparent">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    CornerRadius="8"
                                    Margin="4"
                                    Width="200"
                                    HorizontalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="4" BlurRadius="15" Color="{StaticResource ColorForestGreen}" Opacity="0.1"/>
                                </Border.Effect>
                                <Grid>
                                    <StackPanel Margin="10">
                                        <TextBlock FontWeight="Bold" 
                                                   Text="{Binding DayName}"
                                                   FontSize="18"
                                                   Foreground="{StaticResource BrushDarkGreen}"/>
                                        <TextBlock Text="{Binding Date}" 
                                                   FontSize="14"
                                                   Foreground="{StaticResource BrushGray}" 
                                                   Margin="0,0,0,10"/>
                                        <ItemsControl x:Name="TasksList" ItemsSource="{Binding Tasks}"
                                                      Visibility="{Binding HasItems, ElementName=TasksList, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BrushBorderGray}" BorderThickness="0,0,0,1" Padding="0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="[?]"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding TaskType}" Value="Полив">
                                                                                <Setter Property="Text" Value="[П]"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource BrushForestGreen}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding TaskType}" Value="Удобрение">
                                                                                <Setter Property="Text" Value="[У]"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource BrushTerracotta}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="1" Text="{Binding TaskDescription}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource BrushDarkGreen}" FontWeight="Medium"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock Text="На текущий день задач нету"
                                               Foreground="{StaticResource BrushGray}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=TasksList}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- Month View -->
            <Grid Visibility="{Binding IsMonthViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding MonthTasks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="8" Margin="2" Padding="5">
                                
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Color="{StaticResource ColorForestGreen}" Opacity="0.05"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">
                                        
                                        <TextBlock Text="{Binding FullDate, StringFormat='d MMM', ConverterCulture='ru-RU'}"
                   FontWeight="Bold"
                  HorizontalAlignment="Right"
                  Foreground="{StaticResource BrushDarkGreen}"
                  Margin="0,0,5,0"/>
                                        
                                        <!-- Separator after Date -->
                                        
                                        <Border BorderBrush="{StaticResource BrushBorderGray}" BorderThickness="0,0,0,1" Margin="5,5,5,0"/>
                                        
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="0,5,0,0">
                                        <!-- Task Counts Panel -->
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTasks}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="[П]:" FontWeight="Bold" Foreground="{StaticResource BrushForestGreen}"/>
                                            <Run Text="{Binding WateringTaskCount}" FontWeight="Medium" Foreground="{StaticResource BrushDarkGreen}"/>
                                            <Run Text=" [У]:" FontWeight="Bold" Foreground="{StaticResource BrushTerracotta}"/>
                                            <Run Text="{Binding FertilizingTaskCount}" FontWeight="Medium" Foreground="{StaticResource BrushDarkGreen}"/>
                                        </TextBlock>

                                        <!-- No Tasks Label -->
                                        <TextBlock Text="Нет" Foreground="{StaticResource BrushGray}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTasks}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

    </Grid>
</UserControl>