<Window x:Class="Plantify.Views.ConfirmationDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Plantify.Views"
        xmlns:vm="clr-namespace:Plantify.ViewModels"
        mc:Ignorable="d"
        Title="Подтверждение" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushMilkWhite}"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance Type=vm:ConfirmationDialogViewModel}">
    <Border Padding="20" BorderBrush="{StaticResource BrushTerracotta}" BorderThickness="2">
        <StackPanel MinWidth="300">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,20"/>
            <CheckBox Content="Применить ко всем оставшимся" IsChecked="{Binding ApplyToAll}" Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Да" Command="{Binding YesCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource SecondaryButtonStyle}" Background="{StaticResource BrushForestGreen}" Foreground="{StaticResource BrushPureWhite}" MinWidth="80"/>
                <Button Content="Нет" Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" MinWidth="80"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
