<Window x:Class="Plantify.Views.ConfirmationDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Plantify.ViewModels"
        mc:Ignorable="d"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        d:DataContext="{d:DesignInstance Type=vm:ConfirmationDialogViewModel}">
    <Border Background="{StaticResource BrushMilkWhite}"
            BorderBrush="{StaticResource BrushDarkGreen}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Height="30" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Подтверждение" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="{StaticResource BrushDarkGreen}"/>
                <Button Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource CloseButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="30" />
            </Grid>

            <!-- Content -->
            <StackPanel Grid.Row="1" MinWidth="350" Margin="20">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,20" FontSize="16"/>
                <CheckBox Content="Применить ко всем оставшимся" IsChecked="{Binding ApplyToAll}" 
                          Visibility="{Binding ShowApplyToAll, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Да" Command="{Binding YesCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource SecondaryButtonStyle}" Background="{StaticResource BrushForestGreen}" Foreground="{StaticResource BrushPureWhite}" MinWidth="70" Padding="10,5"/>
                    <Button Content="Нет" Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" MinWidth="70" Padding="10,5"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
