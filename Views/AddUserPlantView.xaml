<UserControl x:Class="Plantify.Views.AddUserPlantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Plantify.Views"
             xmlns:vm="clr-namespace:Plantify.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:AddUserPlantViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BrushForestGreen20Transparent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushDarkGreen}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushDarkGreen}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BrushForestGreen20Transparent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushDarkGreen}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushDarkGreen}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>

        <Style x:Key="FormComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushForestGreen20Transparent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource BrushDarkGreen}"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
        </Style>

    </UserControl.Resources>
    
    <Border Background="{StaticResource BrushMilkWhite}" CornerRadius="12" Padding="30" MaxWidth="500">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" TextWrapping="Wrap"/>
                <Button Command="{Binding CancelCommand}" Style="{StaticResource CloseButtonStyle}" 
                        HorizontalAlignment="Right" VerticalAlignment="Top" Width="35" Height="35" Margin="0,-25,-25,0"/>
            </Grid>
            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-20,0" Padding="0,0,20,0" Style="{StaticResource ScrollBarStyle}">
                <StackPanel>
                    <TextBlock Text="Выберите растение" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding AllPlants}"
                              SelectedItem="{Binding SelectedPlant}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource FormComboBoxStyle}"
                              ItemContainerStyle="{StaticResource FormComboBoxItemStyle}"/>

                    <TextBlock Text="Имя (необязательно)" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" Style="{StaticResource FormTextBoxStyle}"/>

                    <TextBlock Text="Местоположение" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" Style="{StaticResource FormTextBoxStyle}"/>

                    <TextBlock Text="Описание" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                             Height="100" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalAlignment="Stretch"
                             Style="{StaticResource FormTextBoxStyle}"/>

                    <TextBlock Text="Дата последнего полива" Style="{StaticResource FormLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding LastWateringDate, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" />

                    <TextBlock Text="Дата последнего удобрения" Style="{StaticResource FormLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding LastFertilizingDate, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="2"
                       Text="{Binding ErrorMessage}"
                       Foreground="IndianRed"
                       FontWeight="Medium"
                       TextWrapping="Wrap"
                       Margin="0,15,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
            
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                <Button Content="Отмена" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="Сохранить" Command="{Binding SaveCommand}" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryActionButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>