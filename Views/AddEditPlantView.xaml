<UserControl x:Class="Plantify.Views.AddEditPlantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Plantify.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:AddEditPlantViewModel, IsDesignTimeCreatable=False}">
    
    <Border Background="{StaticResource BrushMilkWhite}" CornerRadius="12" Padding="30" Width="800">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" TextWrapping="Wrap"/>
                <Button Command="{Binding CancelCommand}" Style="{StaticResource CloseButtonStyle}" 
                        HorizontalAlignment="Right" VerticalAlignment="Top" Width="35" Height="35" Margin="0,-25,-25,0"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-20,0" Padding="0,0,20,0" Style="{StaticResource ScrollBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FormLabelStyle}">
                            <Run Text="Название растения"/>
                            <Run Text="*" Foreground="{StaticResource BrushTerracotta}"/>
                        </TextBlock>
                        <TextBox Text="{Binding PlantName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" HorizontalAlignment="Stretch"/>
                        <TextBlock Style="{StaticResource FormLabelStyle}">
                            <Run Text="Вид"/>
                            <Run Text="*" Foreground="{StaticResource BrushTerracotta}"/>
                        </TextBlock>
                        <ComboBox ItemsSource="{Binding Varieties}" SelectedItem="{Binding SelectedVariety}" DisplayMemberPath="Name" IsEditable="False" Style="{StaticResource FormComboBoxStyle}" HorizontalAlignment="Stretch"/>
                        <TextBlock Style="{StaticResource FormLabelStyle}">
                            <Run Text="Требования к свету"/>
                            <Run Text="*" Foreground="{StaticResource BrushTerracotta}"/>
                        </TextBlock>
                        <ComboBox ItemsSource="{Binding LightRequirements}" SelectedItem="{Binding SelectedLightRequirement}" DisplayMemberPath="Name" IsEditable="False" Style="{StaticResource FormComboBoxStyle}" HorizontalAlignment="Stretch"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Интервал полива (дней)" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding WateringInterval, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Интервал удобрения (дней)" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding FertilizingInterval, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Изображение" Style="{StaticResource FormLabelStyle}"/>
                        <Border BorderBrush="{StaticResource BrushForestGreen}" BorderThickness="1" CornerRadius="0" Height="160" Width="160" Margin="0,0,0,10" HorizontalAlignment="Left">
                            <Image Source="{Binding DisplayImageSource}" Stretch="UniformToFill" />
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ImagePath, Mode=OneWay}" Style="{StaticResource FormTextBoxStyle}" IsReadOnly="True" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Выбрать..." Command="{Binding SelectImageCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Text="Разделы описания" Style="{StaticResource FormLabelStyle}"/>
                    
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushGray}" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Заголовок раздела" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" />
                                                <TextBlock Text="Содержимое раздела" Style="{StaticResource Caption}" Margin="0,10,0,2"/>
                                                <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>                                            </StackPanel>
                                            <Button Grid.Column="1" Content="✕" 
                                                    Command="{Binding DataContext.RemoveSectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource CloseButtonStyle}" VerticalAlignment="Top" Margin="10,-5,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <Button Content="Добавить раздел" Command="{Binding AddSectionCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="IndianRed" FontWeight="Medium" TextWrapping="Wrap" Margin="0,15,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                <Button Content="Отмена" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Margin="10,0,0,0" Style="{StaticResource PrimaryActionButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>