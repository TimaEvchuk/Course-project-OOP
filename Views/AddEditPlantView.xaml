<UserControl x:Class="Plantify.Views.AddEditPlantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Plantify.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:AddEditPlantViewModel, IsDesignTimeCreatable=False}">
    
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadDistinctPropertiesCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <UserControl.Resources>
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{StaticResource BrushForestGreen20Transparent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushDarkGreen}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushDarkGreen}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BrushForestGreen20Transparent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushDarkGreen}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushDarkGreen}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource BrushDarkGreen}"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <TextBlock x:Name="CloseButtonText" Text="✕" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushGray}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseButtonText" Property="Foreground" Value="IndianRed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource BrushMilkWhite}" CornerRadius="12" Padding="30" Width="800">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" TextWrapping="Wrap"/>
                <Button Command="{Binding CancelCommand}" Style="{StaticResource CloseButtonStyle}" 
                        HorizontalAlignment="Right" VerticalAlignment="Top" Width="35" Height="35" Margin="0,-25,-25,0"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-20,0" Padding="0,0,20,0" Style="{StaticResource ScrollBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Название растения" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding PlantName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="Вид" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Varieties}" SelectedItem="{Binding Variety}" IsEditable="False" Style="{StaticResource FormComboBoxStyle}" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="Требования к свету" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding LightRequirements}" SelectedItem="{Binding LightRequirement}" IsEditable="False" Style="{StaticResource FormComboBoxStyle}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Интервал полива (дней)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding WateringInterval, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="Интервал удобрения (дней)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding FertilizingInterval, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="Изображение" Style="{StaticResource FormLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ImagePath, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource FormTextBoxStyle}"/>
                            <Button Grid.Column="1" Content="Выбрать..." Command="{Binding SelectImageCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Text="Описание" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource FormTextBoxStyle}" Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch"/>
                </Grid>
            </ScrollViewer>

            <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="IndianRed" FontWeight="Medium" TextWrapping="Wrap" Margin="0,15,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                <Button Content="Отмена" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Margin="10,0,0,0" Style="{StaticResource PrimaryActionButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>