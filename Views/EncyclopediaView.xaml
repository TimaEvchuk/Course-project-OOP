<UserControl x:Class="Plantify.Views.EncyclopediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Plantify.Views"
             xmlns:vm="clr-namespace:Plantify.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:EncyclopediaViewModel, IsDesignTimeCreatable=False}"
             Background="{StaticResource BrushMilkWhite}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Поиск растений в справочнике" Style="{StaticResource H1}" Margin="0,0,0,20"/>

        <!-- Search Box -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{StaticResource BrushBorderGray}" BorderThickness="1" CornerRadius="5" Padding="5" Width="400" HorizontalAlignment="Left" Background="{StaticResource BrushPureWhite}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBlock Grid.Column="1" Text="Найдите растение..." IsHitTestVisible="False" VerticalAlignment="Center" Foreground="Gray" Margin="5,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" BorderThickness="0" Background="Transparent"
                         Style="{StaticResource SearchTextBoxStyle}"/>
                </Grid>
            </Border>
            
            <Button Grid.Column="1" Content="Предложить растение" Command="{Binding SuggestNewPlantCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right"/>
        </Grid>
        
        <!-- Filter Pills -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" Margin="0,10,0,10" Style="{StaticResource ScrollBarStyle}" Padding="0,10,0,10">
            <!-- DropShadowEffect removed from here -->
            <ItemsControl ItemsSource="{Binding AllCategories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Content="{Binding}" 
                                     Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" 
                                     CommandParameter="{Binding}" 
                                     Style="{StaticResource FilterPillRadioButtonStyle}">
                            <RadioButton.IsChecked>
                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                    <Binding Path="."/>
                                    <Binding Path="DataContext.SelectedFilter" RelativeSource="{RelativeSource AncestorType=ScrollViewer}"/>
                                </MultiBinding>
                            </RadioButton.IsChecked>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Plant List -->
        <Border Grid.Row="3" Background="{StaticResource BrushMilkWhite}" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" Direction="90" BlurRadius="5" Color="{StaticResource ColorBaseGray}" Opacity="0.05" />
            </Border.Effect>
            <ListBox ItemsSource="{Binding Plants}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent"
                     ScrollViewer.CanContentScroll="False">
                <ListBox.Resources>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollBarStyle}"/>
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="12" Background="{StaticResource BrushPureWhite}" Margin="0,0,24,24" Height="140">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="8" BlurRadius="24" Color="{StaticResource ColorForestGreen}" Opacity="0.1"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border CornerRadius="12" Margin="10" Width="120" Height="120">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding DisplayImageSource, TargetNullValue={StaticResource ImgPlaceholder}}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                
                                <Grid Grid.Column="1" Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Text="{Binding Name}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,0,80,0"/>
                                    <TextBlock Grid.Row="1" Text="{Binding ShortDescription}" Style="{StaticResource Body}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="72" Margin="0,5,120,0" VerticalAlignment="Top"/>
                                    <Button Grid.Row="2" Content="Читать →" Command="{Binding DataContext.ShowPlantDetailCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="16" FontWeight="Bold">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushForestGreen}"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushDarkGreen}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                
                                <Border Grid.ColumnSpan="2" Background="{StaticResource BrushForestGreen20Transparent}" CornerRadius="10" Padding="8,4" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="15">
                                    <TextBlock Text="{Binding Variety}" Foreground="{StaticResource BrushForestGreen}" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>