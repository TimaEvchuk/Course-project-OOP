<UserControl x:Class="Plantify.Views.PlantDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Plantify.Views"
             xmlns:vm="clr-namespace:Plantify.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PlantDetailViewModel, IsDesignTimeCreatable=False}">
    <Border Background="{StaticResource BrushPureWhite}" CornerRadius="12" Margin="30">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="450"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Image -->
            <Border Grid.Row="0" Grid.Column="0" CornerRadius="12" Margin="15,15,0,15" Height="200">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Plant.DisplayImageSource, TargetNullValue={StaticResource ImgPlaceholder}}" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <!-- Right Side Content -->
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="20">
                <TextBlock Text="{Binding Plant.Name}" Style="{StaticResource H1}" TextWrapping="Wrap" Margin="0,0,45,0"/>
                <Border Background="{StaticResource BrushForestGreen20Transparent}" CornerRadius="10" Padding="8,4" HorizontalAlignment="Left" Margin="0,10,0,0">
                    <TextBlock Text="{Binding Plant.Variety}" Foreground="{StaticResource BrushForestGreen}" FontSize="12"/>
                </Border>
                <TextBlock Text="{Binding Plant.WateringInterval, StringFormat='Полив: раз в {0} дней'}" Style="{StaticResource Body}" Margin="0,20,0,5"/>
                <TextBlock Text="{Binding Plant.FertilizingInterval, StringFormat='Удобрение: раз в {0} дней'}" Style="{StaticResource Body}"/>
            </StackPanel>

            <!-- Description Sections -->
            <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" Margin="20,10,20,20">
                <ItemsControl ItemsSource="{Binding Plant.Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,15,0,0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Content}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Add to Garden Button -->
            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                    Content="Добавить в сад" 
                    Command="{Binding AddPlantToGardenCommand}"
                    HorizontalAlignment="Right" 
                    Margin="0,0,20,20"
                    Background="{StaticResource BrushForestGreen}"
                    Foreground="{StaticResource BrushPureWhite}"
                    Padding="25,12"
                    BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="PART_Border" Background="{StaticResource BrushForestGreen}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource BrushLightForestGreen}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            
            <!-- Close Button - Declared last to be on top -->
            <Button Grid.Row="0" Grid.Column="1" Panel.ZIndex="1" Command="{Binding CloseCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                    Width="32" Height="32">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushBaseGray}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="16">
                                        <Path Data="M0,0 L12,12 M0,12 L12,0"
                                              Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="2.5"
                                              Width="16" Height="16"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Stretch="Uniform"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushDarkGreen}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
