<UserControl x:Class="Plantify.Views.PlantDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Plantify.Views"
             xmlns:vm="clr-namespace:Plantify.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PlantDetailViewModel, IsDesignTimeCreatable=False}">
    <Border Background="{StaticResource BrushMilkWhite}" CornerRadius="12" Margin="30">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="450"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Image -->
            <Border Grid.Row="0" Grid.Column="0" CornerRadius="12" Margin="15,15,0,15" Height="200">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Plant.DisplayImageSource, TargetNullValue={StaticResource ImgPlaceholder}}" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <!-- Right Side Content -->
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="20">
                <TextBlock Text="{Binding Plant.PlantModel.Name}" Style="{StaticResource H1}" TextWrapping="Wrap" Margin="0,0,45,0"/>

                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="Вид" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Plant.PlantModel.Variety.Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                        <TextBlock Text="Полив" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Plant.PlantModel.WateringInterval, StringFormat='Раз в {0} дней'}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="Освещение" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Plant.PlantModel.LightRequirement.Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,10">
                        <TextBlock Text="Удобрение" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Plant.PlantModel.FertilizingInterval, StringFormat='Раз в {0} дней'}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Description Sections -->
            <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" Margin="20,10,20,20" Style="{StaticResource ScrollBarStyle}">
                <ItemsControl ItemsSource="{Binding Plant.PlantModel.Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,15,0,0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Content}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Add to Garden Button -->
            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                    Content="Добавить в сад" 
                    Command="{Binding AddPlantToGardenCommand}"
                    HorizontalAlignment="Right" 
                    Margin="0,0,20,20"
                    Background="{StaticResource BrushForestGreen}"
                    Foreground="{StaticResource BrushPureWhite}"
                    Padding="25,12"
                    BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="PART_Border" Background="{StaticResource BrushForestGreen}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource BrushLightForestGreen}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            
            <!-- Close Button - Declared last to be on top -->
            <Button Grid.Row="0" Grid.Column="1" Panel.ZIndex="1" Command="{Binding CloseCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Style="{StaticResource CloseButtonStyle}"/>
        </Grid>
    </Border>
</UserControl>