<UserControl x:Class="Plantify.Views.PremiumPurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Plantify.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PremiumPurchaseViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
    </UserControl.Resources>
    
    <Border Background="{StaticResource BrushMilkWhite}" CornerRadius="12" Padding="30" MaxWidth="450">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Приобрести Премиум" Style="{StaticResource H1}" TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
                <Button Command="{Binding CancelCommand}" Style="{StaticResource CloseButtonStyle}" 
                        HorizontalAlignment="Right" VerticalAlignment="Top" Width="35" Height="35" Margin="0,-25,-25,0"/>
            </Grid>
            
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Тариф: Премиум" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"
                           HorizontalAlignment="Center" Foreground="{StaticResource BrushDarkGreen}"/>
                <TextBlock Text="Период: 1 месяц" FontSize="16" Margin="0,0,0,5"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Цена: 500 руб." FontSize="16" Margin="0,0,0,20"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Наслаждайтесь неограниченным количеством растений и эксклюзивными функциями!"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,30"
                           Foreground="{StaticResource BrushGray}"/>
            </StackPanel>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="Купить" Command="{Binding BuyPremiumCommand}" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryActionButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
