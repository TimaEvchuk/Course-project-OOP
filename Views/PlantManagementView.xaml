<UserControl x:Class="Plantify.Views.PlantManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Plantify.Views"
             xmlns:vm="clr-namespace:Plantify.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:converters="clr-namespace:Plantify.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PlantManagementViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="600" d:DesignWidth="900">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadDataCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управление контентом" Style="{StaticResource H1}" Margin="0,0,0,20"/>

        <TabControl Grid.Row="1">
            <TabItem Header="Каталог">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0" ItemsSource="{Binding Plants}" SelectedItem="{Binding SelectedPlant}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Вид" Binding="{Binding Variety}" Width="150"/>
                                <DataGridTextColumn Header="Освещение" Binding="{Binding LightRequirement}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="LightGray"
                                      Visibility="{Binding SelectedPlant, Converter={StaticResource NullToVisibilityCollapsedConverter}}"/>
                        
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Width="400"
                                      Style="{StaticResource ScrollBarStyle}"
                                      Visibility="{Binding SelectedPlant, Converter={StaticResource NullToVisibilityCollapsedConverter}}">
                            <ScrollViewer.Effect>
                                <DropShadowEffect ShadowDepth="2" Direction="270" BlurRadius="5" Color="{StaticResource ColorBaseGray}" Opacity="0.05" />
                            </ScrollViewer.Effect>
                            <StackPanel Margin="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Height="120" Width="120" Grid.Column="0" VerticalAlignment="Top" Margin="0,10,20,0"
                                           Source="{Binding SelectedPlant.DisplayImageSource, TargetNullValue={StaticResource ImgPlaceholder}}"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding SelectedPlant.Name}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                                        
                                        <Grid Margin="0,10,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="120"/>
                                                <ColumnDefinition Width="*" MinWidth="125"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                                <TextBlock Text="Вид" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding SelectedPlant.Variety}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                                                <TextBlock Text="Полив" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding SelectedPlant.WateringInterval, StringFormat='Раз в {0} дней'}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                                                <TextBlock Text="Освещение" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding SelectedPlant.LightRequirement}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,10">
                                                <TextBlock Text="Удобрение" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding SelectedPlant.FertilizingInterval, StringFormat='Раз в {0} дней'}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                
                                <ItemsControl ItemsSource="{Binding SelectedPlant.Sections}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,15">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H3}"/>
                                                <TextBlock Text="{Binding Content}" Style="{StaticResource Body}" FontSize="14" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    
                    <Border Grid.Row="1" Background="#F0F0F0" Padding="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Добавить" Command="{Binding AddPlantCommand}" Style="{StaticResource PrimaryActionButtonStyle}"/>
                            <Button Content="Изменить" Command="{Binding UpdatePlantCommand}" IsEnabled="{Binding SelectedPlant, Converter={StaticResource NullToFalseConverter}}" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Content="Удалить" Command="{Binding DeletePlantCommand}" IsEnabled="{Binding SelectedPlant, Converter={StaticResource NullToFalseConverter}}" Margin="10,0,0,0" Style="{StaticResource DeletePlantButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Заявки на модерацию">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0" ItemsSource="{Binding PendingSubmissions}" SelectedItem="{Binding SelectedSubmission}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Автор" Binding="{Binding SubmittedByUser.Login}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="LightGray"
                                      Visibility="{Binding SelectedSubmission, Converter={StaticResource NullToVisibilityCollapsedConverter}}"/>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Width="400"
                                      Style="{StaticResource ScrollBarStyle}"
                                      Visibility="{Binding SelectedSubmission, Converter={StaticResource NullToVisibilityCollapsedConverter}}">
                            <ScrollViewer.Effect>
                                <DropShadowEffect ShadowDepth="2" Direction="270" BlurRadius="5" Color="{StaticResource ColorBaseGray}" Opacity="0.05" />
                            </ScrollViewer.Effect>
                            <StackPanel Margin="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Height="120" Width="120" Grid.Column="0" VerticalAlignment="Top" Margin="0,10,20,0"
                                           Source="{Binding SelectedSubmission.ImagePath, Converter={StaticResource StringToImageSourceConverter}}"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding SelectedSubmission.Name}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                                        
                                        <Grid Margin="0,10,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="130"/>
                                                <ColumnDefinition Width="*" MinWidth="130"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                                <TextBlock Text="Вид" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding SelectedSubmission.Variety.Name}" Style="{StaticResource Body}"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                                                <TextBlock Text="Полив" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding SelectedSubmission.WateringInterval, StringFormat='Раз в {0} дней'}" Style="{StaticResource Body}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                                                <TextBlock Text="Освещение" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding SelectedSubmission.LightRequirement.Name}" Style="{StaticResource Body}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,10">
                                                <TextBlock Text="Удобрение" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding SelectedSubmission.FertilizingInterval, StringFormat='Раз в {0} дней'}" Style="{StaticResource Body}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                
                                <ItemsControl ItemsSource="{Binding SelectedSubmission.Description, Converter={StaticResource JsonToSectionsConverter}}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,15">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H3}"/>
                                                <TextBlock Text="{Binding Content}" Style="{StaticResource Body}" FontSize="14" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    
                    <Border Grid.Row="1" Background="#F0F0F0" Padding="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Одобрить" Command="{Binding ApproveSubmissionCommand}" IsEnabled="{Binding SelectedSubmission, Converter={StaticResource NullToFalseConverter}}" Style="{StaticResource PrimaryActionButtonStyle}"/>
                            <Button Content="Отклонить" Command="{Binding RejectSubmissionCommand}" IsEnabled="{Binding SelectedSubmission, Converter={StaticResource NullToFalseConverter}}" Margin="10,0,0,0" Style="{StaticResource DeletePlantButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Категории" Padding="10">
                <Grid Background="#F0F0F0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Varieties Column -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Виды растений" Style="{StaticResource H2}" Margin="10,10,0,10"/>
                        <ListView Grid.Row="1" ItemsSource="{Binding Varieties}" SelectedItem="{Binding SelectedVariety}" DisplayMemberPath="Name" Margin="10,0,0,0"/>
                        <Border Grid.Row="2" Background="#F0F0F0" Padding="10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Добавить" Command="{Binding AddVarietyCommand}" Style="{StaticResource PrimaryActionButtonStyle}"/>
                                <Button Content="Редактировать" Command="{Binding UpdateVarietyCommand}" IsEnabled="{Binding SelectedVariety, Converter={StaticResource NullToFalseConverter}}" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Content="Удалить" Command="{Binding DeleteVarietyCommand}" IsEnabled="{Binding SelectedVariety, Converter={StaticResource NullToFalseConverter}}" Margin="10,0,0,0" Style="{StaticResource DeletePlantButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Light Requirements Column -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Требования к свету" Style="{StaticResource H2}" Margin="0,10,10,10"/>
                        <ListView Grid.Row="1" ItemsSource="{Binding LightRequirements}" SelectedItem="{Binding SelectedLightRequirement}" DisplayMemberPath="Name" Margin="0,0,10,0"/>
                        <Border Grid.Row="2" Background="#F0F0F0" Padding="10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Добавить" Command="{Binding AddLightRequirementCommand}" Style="{StaticResource PrimaryActionButtonStyle}"/>
                                <Button Content="Редактировать" Command="{Binding UpdateLightRequirementCommand}" IsEnabled="{Binding SelectedLightRequirement, Converter={StaticResource NullToFalseConverter}}" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Content="Удалить" Command="{Binding DeleteLightRequirementCommand}" IsEnabled="{Binding SelectedLightRequirement, Converter={StaticResource NullToFalseConverter}}" Margin="10,0,0,0" Style="{StaticResource DeletePlantButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>