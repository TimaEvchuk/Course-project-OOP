<UserControl x:Class="Plantify.Views.NotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Plantify.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:NotificationViewModel, IsDesignTimeCreatable=True}"
             Width="320" MaxHeight="400">
    <UserControl.Resources>
        <Style x:Key="NotificationCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock x:Name="CloseButtonText" Text="✕" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushGray}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseButtonText" Property="Foreground" Value="IndianRed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{StaticResource BrushMilkWhite}"
            BorderBrush="{StaticResource BrushBorderGray}"
            BorderThickness="1"
            CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="2" BlurRadius="10" Color="{StaticResource ColorForestGreen}" Opacity="0.1"/>
        </Border.Effect>
        <StackPanel>
            <Grid Height="40" Margin="15,5,5,5">
                <TextBlock Text="Уведомления" Style="{StaticResource H2}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Button Command="{Binding CloseCommand}"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Height="30" Width="30"
                        Style="{StaticResource NotificationCloseButtonStyle}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <TextBlock x:Name="CloseButtonText" Text="✕" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" FontWeight="Normal"
                                           Foreground="{DynamicResource BrushGray}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseButtonText" Property="Foreground" Value="IndianRed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            
            <Border BorderBrush="{StaticResource BrushBorderGray}" BorderThickness="0,1,0,0"
                    Visibility="{Binding HasNotifications, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>

            <TextBlock Text="Новых уведомлений нет" 
                       HorizontalAlignment="Center" 
                       Foreground="Gray"
                       Margin="0,50,0,50">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNotifications}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer Style="{DynamicResource ScrollBarStyle}" 
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Notifications}" Margin="15,0,15,15">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="4" Margin="0,5" Padding="10">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="4" BlurRadius="15" Color="{StaticResource ColorForestGreen}" Opacity="0.1"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat='d MMMM'}" Foreground="Gray" VerticalAlignment="Center" Margin="10,0"/>
                                    <Button Grid.Column="2" Command="{Binding DismissCommand}" Style="{StaticResource NotificationCloseButtonStyle}" Width="20" Height="20" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>