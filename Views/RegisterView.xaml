<UserControl x:Class="Plantify.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Plantify.Views"
             xmlns:vm="clr-namespace:Plantify.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:RegisterViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="700" d:DesignWidth="1200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles/Typography.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/TextBoxes.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/Buttons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Border Width="300" Height="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource BrushMilkWhite}"
                CornerRadius="12"
                Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ScrollBarStyle}">
                <StackPanel>
                    <TextBlock Text="Plantify" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource BrushDarkGreen}" FontFamily="{StaticResource FontLora}"/>
                    <TextBlock Text="Уход за вашим садом" FontSize="14" HorizontalAlignment="Center" Foreground="{StaticResource BrushDarkGray}" Margin="0,0,0,10"/>

                    <TextBlock Text="Создать Аккаунт" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,10"/>

                    <TextBlock Text="Логин" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Style="{StaticResource FormTextBoxStyle}" Margin="0,3,0,0"/>
                    
                    <TextBlock Text="Email" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Style="{StaticResource FormTextBoxStyle}" Margin="0,3,0,0"/>

                    <TextBlock Text="Пароль" Style="{StaticResource FormLabelStyle}"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource FormPasswordBoxStyle}" PasswordChanged="PasswordBox_PasswordChanged" />

                    <TextBlock Text="Подтвердите пароль" Style="{StaticResource FormLabelStyle}"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource FormPasswordBoxStyle}" PasswordChanged="ConfirmPasswordBox_PasswordChanged" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap" MinHeight="30"/>

                    <Button Content="Зарегистрироваться" Command="{Binding RegisterCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,10,0,0" IsDefault="True"/>
                    <Button Content="Назад ко входу" Command="{Binding GoToLoginCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
