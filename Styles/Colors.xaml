<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color styles -->
    <Color x:Key="ColorForestGreen">#3A6A4D</Color>
    <Color x:Key="ColorDarkGreen">#1E392A</Color>
    <Color x:Key="ColorSand">#E0CDB3</Color>
    <Color x:Key="ColorTerracotta">#D97D54</Color>
    <Color x:Key="ColorMilkWhite">#FDFCF8</Color>
    <Color x:Key="ColorPureWhite">#FFFFFF</Color>
    <Color x:Key="ColorBaseGray">#CCCCCC</Color>
    <Color x:Key="ColorLightGray">#F0F0F0</Color>
    <Color x:Key="ColorBorderGray">#E0E0E0</Color>
    <Color x:Key="ColorForestGreen20Transparent">#333A6A4D</Color>
    <Color x:Key="ColorLightForestGreen">#578F6B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushForestGreen" Color="{StaticResource ColorForestGreen}"/>
    <SolidColorBrush x:Key="BrushDarkGreen" Color="{StaticResource ColorDarkGreen}"/>
    <SolidColorBrush x:Key="BrushLightForestGreen" Color="{StaticResource ColorLightForestGreen}"/>
    <SolidColorBrush x:Key="BrushSand" Color="{StaticResource ColorSand}"/>
    <SolidColorBrush x:Key="BrushTerracotta" Color="{StaticResource ColorTerracotta}"/>
    <SolidColorBrush x:Key="BrushMilkWhite" Color="{StaticResource ColorMilkWhite}"/>
    <SolidColorBrush x:Key="BrushPureWhite" Color="{StaticResource ColorPureWhite}"/>
    <SolidColorBrush x:Key="BrushBaseGray" Color="{StaticResource ColorBaseGray}"/>
    <SolidColorBrush x:Key="BrushLightGray" Color="{StaticResource ColorLightGray}"/>
    <SolidColorBrush x:Key="BrushBorderGray" Color="{StaticResource ColorBorderGray}"/>
    <SolidColorBrush x:Key="BrushForestGreen20Transparent" Color="{StaticResource ColorForestGreen20Transparent}"/>

</ResourceDictionary>
